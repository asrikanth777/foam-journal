FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [kinematicPressure];

// reference pressure?
// in incomp flow, pressure diff drives the flow
internalField   uniform 0;


// typically, either velocity or pressure should be fixed and the other "floats"
// fixing both or none will lead to a farfield
// that reflects disturbances back or lose stability
boundaryField
{
    inlet
    {
        type            freestreamPressure;
        freestreamValue $internalField;
    }

    outlet
    {
        type            freestreamPressure;
        freestreamValue $internalField;
    }

    walls
    {
        // standard BL treatment
        // assumes pressure is constant through thickness
        // of a thin BL
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}

