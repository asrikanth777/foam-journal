FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
 
// inner loop: how each linear solve Ax=b is done
solvers
{
    // p eq is elliptic (global) -> multigrid
    p
    {
        solver          GAMG;
        tolerance       1e-06;  // keep tighter than residualControl p
        relTol          0.1;
        smoother        GaussSeidel; // smooths local error on each grid level
    }
 
    // transport eq (local) -> simple smoother is enough
    U
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-08;  // absolute
        relTol          0.1;    // relative to initial residual of this solve
    }
 
    // SA modified turbulent viscosity (not k), also a transport eq
    nuTilda
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-08;
        relTol          0.1;
    }
}
 
// outer loop: U predictor -> p eq -> correct U -> turbulence, repeat
SIMPLE
{
    nNonOrthogonalCorrectors 0; // raise if checkMesh non-orthogonality > ~70
 
    // stop when INITIAL residuals drop below these
    residualControl
    {
        p               1e-5;
        U               1e-5;
        nuTilda         1e-5;
    }
}
 
// p correction overshoots -> damp it; doesn't change converged answer
relaxationFactors
{
    fields
    {
        p               0.3;    // after solve: take 30% of the change
    }
    equations
    {
        U               0.7;    // before solve: boosts diagonal
        nuTilda         0.7;
    }
}
 
 
